---
import { Image } from 'astro:assets';
import ArrowIcon from '../components/ArrowIcon.astro';
import SpaceIcon from '../components/SpaceIcon.astro';
import hero from '../assets/hero.png';
import reception from '../assets/reception.png';
import office from '../assets/office.png';
import cafe from '../assets/cafe.png';
import school from '../assets/school.png';
import retail from '../assets/retail.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../data/catalog.json';

// Category photos live in public/images/categories/<slug>.jpg; photographer credits are in CREDITS.md.
// `space` pre-selects that option in the enquiry form when the card is clicked.
const categories = [
  { name: 'Desk & Countertop', slug: 'desk-countertop', description: 'Perfect for personal workspaces and small office nooks.', alt: 'Small potted plants beside a notebook on a wooden desk' },
  { name: 'Floor & Corner', slug: 'floor-corner', description: 'Fill empty spaces with durable, low-care life.', alt: 'Tall snake plant beside a table in a sunlit room corner' },
  { name: 'Statement & Feature', slug: 'statement-feature', description: 'Make a lasting impression in lobbies and retail.', alt: 'Large potted palm trees in a bright modern lobby' },
  { name: 'Low-Light Plants', slug: 'low-light-plants', description: 'Thrive in interior rooms with limited sunlight.', alt: 'Pothos and snake plants on a wooden shelf indoors' },
  { name: 'Air-Purifying', slug: 'air-purifying', description: 'Clean air solutions for schools and busy offices.', alt: 'Peace lilies lined up along a window in a modern office' },
  { name: 'Café Solutions', slug: 'cafe-solutions', space: 'cafe', description: 'Strategic greenery that supports your branding.', alt: 'Potted greenery arranged around a café counter and shelves' },
  { name: 'Office Comfort', slug: 'office-comfort', space: 'office', description: 'Enhance employee focus with natural design.', alt: 'Potted plants around desks and workstations in an office' },
  { name: 'Retail Branding', slug: 'retail-branding', space: 'retail', description: 'Durable setups designed for high-traffic areas.', alt: 'Potted plant displays along the aisle of a retail store' },
];

const spaces = [
  {
    name: 'Offices',
    slug: 'office',
    number: '01',
    image: office,
    alt: 'A bright office workspace styled with practical indoor plants',
    description: 'Bring a little life to the working day, from the first hello at reception to the quietest desk corner.',
    plants: 'Desk plants · Floor plants · Low-light options',
  },
  {
    name: 'Cafés',
    slug: 'cafe',
    number: '02',
    image: cafe,
    alt: 'A warm café with greenery around its counter and seating',
    description: 'Greenery that feels at home with your atmosphere and stays clear of the bustle of service.',
    plants: 'Countertop plants · Trailing plants · Features',
  },
  {
    name: 'Schools',
    slug: 'school',
    number: '03',
    image: school,
    alt: 'A welcoming school library with plants on shelves and in corners',
    description: 'Hardy, manageable plants for spaces where learning, movement, and everyday life happen.',
    plants: 'Shelf plants · Corner plants · Easy care',
  },
  {
    name: 'Retail spaces',
    slug: 'retail',
    number: '04',
    image: retail,
    alt: 'A lifestyle shop with statement greenery beside its displays',
    description: 'Make an entrance with plants that complement your displays without getting in the way.',
    plants: 'Statement plants · Display plants · Floor plants',
  },
];

const questions = [
  {
    question: 'What if I don’t know my light conditions?',
    answer: 'That’s fine. Choose “Not sure” on the form. Light is one of the things we assess, and a photo of your space helps if you have one.',
  },
  {
    question: 'What information do you need to get started?',
    answer: 'Just your name, how you’d like us to contact you, and your type of space. Light, approximate size, a photo, and notes are optional.',
  },
  {
    question: 'Can I request a plan without photos?',
    answer: 'Absolutely. Photos are optional. Tell us what you can about the space and we’ll follow up if we need more detail.',
  },
  {
    question: 'What does installation support include?',
    answer: 'We help with placement and setup so each plant suits its conditions and the way people use the space.',
  },
];
---

<BaseLayout title="Plantliner — The right plant for the right space" description="Plantliner creates thoughtful plant solutions for offices, cafés, schools, and retail spaces. Find the right plant for your space.">
      <section class="hero" aria-labelledby="hero-title">
        <Image class="hero-image" src={hero} alt="Sunlit commercial lounge with thoughtfully arranged indoor plants" width={1800} widths={[640, 1080, 1800]} sizes="(max-width: 760px) calc(100vw - 36px), 47vw" format="webp" loading="eager" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="container hero-inner">
          <div class="hero-content">
            <p class="eyebrow"><span class="eyebrow-line"></span> Plant solutions for real spaces</p>
            <h1 id="hero-title">The right plant,<br />for the <em>right space.</em></h1>
            <p class="hero-description">Thoughtful plant solutions for offices, cafés, schools, and retail spaces—selected to suit your light, layout, and level of care.</p>
            <div class="hero-actions">
              <a class="button button-green" href="/#enquiry">Request a plant plan <span aria-hidden="true"><ArrowIcon direction="up-right" /></span></a>
              <a class="text-link" href="#solutions">Explore solutions <span aria-hidden="true"><ArrowIcon direction="down" /></span></a>
            </div>
            <p class="hero-note">Your light. Your layout. A plan that belongs.</p>
          </div>
          <div class="hero-caption"><span class="caption-line"></span> Spaces feel better with plants that belong.</div>
        </div>
      </section>

      <div class="principles" aria-label="Our approach">
        <div class="container principles-inner">
          <!-- SVG, not text glyphs: phones render symbols like ✳ as color emoji. Tabler Icons sun / layout-grid / droplet, see THIRD_PARTY_NOTICES.md. -->
          <div><span class="principle-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" /></svg></span><span>Matched to your light</span></div>
          <div><span class="principle-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" /><path d="M14 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" /><path d="M4 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" /><path d="M14 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" /></svg></span><span>Planned for your layout</span></div>
          <div><span class="principle-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M7.502 19.423c2.602 2.105 6.395 2.105 8.996 0c2.602 -2.105 3.262 -5.708 1.566 -8.546l-4.89 -7.26c-.42 -.625 -1.287 -.803 -1.936 -.397a1.376 1.376 0 0 0 -.41 .397l-4.893 7.26c-1.695 2.838 -1.035 6.441 1.567 8.546z" /></svg></span><span>Chosen for your level of care</span></div>
        </div>
      </div>

      <section class="section concept-section" aria-labelledby="concept-title">
        <div class="container concept-grid">
          <div class="concept-image-wrap">
            <Image src={reception} alt="Low-light plants thoughtfully placed around a reception desk" width={900} widths={[360, 540, 720, 900]} sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1100px) 44vw, 50vw" format="webp" loading="lazy" />
            <span class="image-badge">A space, considered</span>
          </div>
          <div class="concept-copy">
            <p class="eyebrow green">Our way of thinking <span class="eyebrow-line"></span></p>
            <h2 id="concept-title">Good greenery<br />starts with <em>getting</em><br /><em>the space.</em></h2>
            <p class="section-intro">A reception with no natural light? We start with the conditions, then choose plants that can genuinely thrive there.</p>
            <div class="concept-detail"><span>01 / The space</span><p>A front desk that greets every visitor, lit mainly by ceiling lights.</p></div>
            <div class="concept-detail"><span>02 / The response</span><p>Low-light ZZ and snake plants frame the desk while keeping the entrance clear.</p></div>
            <p class="fine-print">An illustrative concept of our approach, not a completed client project.</p>
          </div>
        </div>
      </section>

      <section class="section solutions-section" id="solutions" aria-labelledby="solutions-title">
        <div class="container">
          <div class="section-heading solutions-heading">
            <div>
              <p class="eyebrow green">Solutions by space <span class="eyebrow-line"></span></p>
              <h2 id="solutions-title">Every space has<br /><em>room to grow.</em></h2>
            </div>
            <p>Different spaces ask different things of their plants. Find yours, and we’ll make a plan around it.</p>
          </div>
          <div class="slider-controls">
            <div class="slider-chips" role="group" aria-label="Jump to a space">
              {spaces.map((space) => (
                <button type="button" class="slider-chip" aria-controls="space-track"><span>{space.number}</span> {space.name}</button>
              ))}
            </div>
            <div class="slider-arrows">
              <button type="button" class="slider-arrow" aria-controls="space-track" aria-label="Previous space"><ArrowIcon direction="left" /></button>
              <button type="button" class="slider-arrow" aria-controls="space-track" aria-label="Next space"><ArrowIcon direction="right" /></button>
            </div>
          </div>
          <div class="space-grid" id="space-track" role="region" aria-label="Spaces" aria-roledescription="carousel" tabindex="0">
            {spaces.map((space) => (
              <article class="space-card" role="group" aria-roledescription="slide" aria-label={`${space.number} of ${spaces.length}: ${space.name}`}>
                <div class="space-card-surface">
                <div class="space-image">
                  <Image src={space.image} alt={space.alt} width={720} format="webp" loading="lazy" />
                </div>
                <div class="space-copy">
                  <span class="space-number">{space.number} / 04</span>
                  <h3>{space.name}</h3>
                  <p>{space.description}</p>
                  <span class="space-plants">{space.plants}</span>
                  <a href="/#enquiry" data-space={space.slug} class="card-link" aria-label={`Request a plant plan for ${space.name}`}>
                    Request a plan <span aria-hidden="true"><ArrowIcon direction="up-right" /></span>
                  </a>
                </div>
                </div>
              </article>
            ))}
          </div>
          <div class="slider-footer"><span class="slider-hint">Swipe or drag to explore</span><p class="slider-status" aria-live="polite" aria-atomic="true">01 / 04 - Offices</p></div>
          <p class="photo-note">Imagery is illustrative of possible plant styling, not completed Plantliner projects.</p>
        </div>
      </section>

      <section class="section categories-section" id="categories" aria-labelledby="categories-title">
        <div class="container">
          <div class="section-heading categories-heading">
            <div>
              <p class="eyebrow green">Plant categories <span class="eyebrow-line"></span></p>
              <h2 id="categories-title">Find your kind<br />of <em>green.</em></h2>
            </div>
            <p>Start with a spot to fill or a feeling to create. Choose a category to begin your plant plan.</p>
          </div>
          <ul class="category-grid">
            {categories.map((category) => (
              <li>
                <a class="category-card" href="/#enquiry" data-space={category.space} aria-label={`Start a plant plan: ${category.name}`}>
                  <div class="category-image">
                    <SpaceIcon variant="leaf" />
                    {/* Removed if the photo is missing, so the leaf placeholder shows instead of a broken image. */}
                    <img src={`/images/categories/${category.slug}.jpg`} alt={category.alt} width="800" height="600" loading="lazy" decoding="async" onerror="this.remove()" />
                  </div>
                  <div class="category-content">
                    <h3>{category.name}</h3>
                    <p>{category.description}</p>
                    <span class="category-action">Plan my space <span class="category-arrow"><ArrowIcon direction="up-right" /></span></span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section enquiry-section" id="enquiry" aria-labelledby="enquiry-title">
        <Image class="enquiry-backdrop" src={reception} alt="" aria-hidden="true" width={1600} format="webp" loading="lazy" />
        <div class="container enquiry-grid">
          <div class="enquiry-copy">
            <p class="eyebrow light">Your plant plan <span class="eyebrow-line"></span></p>
            <h2 id="enquiry-title">Let's find<br /><em>what fits.</em></h2>
            <p>Start with your kind of space. We'll guide you through a few simple choices and take it from there.</p>
            <a id="preview-entry" class="enquiry-preview-link" href="/#enquiry" hidden>Preview a plant in your space <ArrowIcon direction="up-right" /></a>
            <div class="next-steps">
              <h3>Simple from the start</h3>
              <p><span>01</span> Choose your space.</p>
              <p><span>02</span> Add details if you have them.</p>
              <p><span>03</span> Tell us how to reach you.</p>
            </div>
          </div>
          <div class="form-panel">
            <form id="plant-plan-form" novalidate>
              <div class="form-heading"><span>Build your plant plan</span><span id="step-count">01 / 03</span></div>
              <div class="progress-track" aria-hidden="true"><span id="progress-fill"></span></div>
              <ol class="wizard-progress" aria-label="Request steps">
                <li aria-current="step"><span class="step-marker" aria-hidden="true">1</span>Your space</li><li><span class="step-marker" aria-hidden="true">2</span>Details</li><li><span class="step-marker" aria-hidden="true">3</span>Contact</li>
              </ol>

              <div class="form-step" data-step="0" aria-labelledby="step-space-title">
                <h3 id="step-space-title" tabindex="-1">What kind of space is it?</h3>
                <p class="step-intro">We'll tailor the recommendations to how your space is used.</p>
                <fieldset class="space-field"><legend class="visually-hidden">Type of space</legend>
                  <div class="space-choices">
                    {spaces.map((space) => (
                      <label class="space-choice">
                        <SpaceIcon variant={space.slug as 'office' | 'cafe' | 'school' | 'retail'} />
                        <input type="radio" name="space" value={space.slug} required aria-describedby="space-error" />
                        <span>{space.slug === 'office' ? 'Office' : space.slug === 'cafe' ? 'Café' : space.slug === 'school' ? 'School' : 'Retail space'}</span>
                        <small>{space.slug === 'office' ? 'Desks & meeting rooms' : space.slug === 'cafe' ? 'Counters & seating' : space.slug === 'school' ? 'Classrooms & libraries' : 'Entrances & displays'}</small>
                      </label>
                    ))}
                    <label class="space-choice space-choice-wide"><SpaceIcon variant="other" /><input type="radio" name="space" value="other" aria-describedby="space-error" /><span>Something else</span><small>We'll find what works for your space.</small></label>
                  </div>
                </fieldset>
                <small class="field-error" id="space-error" role="status"></small>
                <button class="button button-green form-submit" type="button" data-next>Continue to details <span aria-hidden="true"><ArrowIcon direction="right" /></span></button>
              </div>

              <div class="form-step" data-step="1" aria-labelledby="step-details-title" hidden>
                <h3 id="step-details-title" tabindex="-1">Tell us a little more.</h3>
                <p class="step-intro">Everything on this step is optional. “Not sure” is a perfectly good answer.</p>
                <div class="field-pair">
                  <div class="field">
                    <label for="light">Light in the space</label>
                    <div class="select-shell"><select id="light" name="light" aria-describedby="light-hint"><option value="">Not sure</option><option>Bright direct light</option><option>Bright indirect light</option><option>Some natural light</option><option>Mostly artificial light</option></select></div>
                    <p class="field-hint" id="light-hint">Think about the light on a typical day.</p>
                  </div>
                  <div class="field">
                    <label for="size">Approximate size</label>
                    <div class="select-shell"><select id="size" name="size" aria-describedby="size-hint"><option value="">Not sure</option><option>Small (under 20 sqm)</option><option>Medium (20-100 sqm)</option><option>Large (100-500 sqm)</option><option>Extra large (over 500 sqm)</option></select></div>
                    <p class="field-hint" id="size-hint">A rough estimate is all we need.</p>
                  </div>
                </div>
                <div class="field"><label for="photo">A photo of your space <span class="optional-label">Optional</span></label><label class="upload-box" for="photo"><span class="upload-icon" aria-hidden="true"><ArrowIcon direction="up" /></span><span class="upload-label" id="photo-label">Choose a photo to share</span><span class="upload-hint" id="photo-hint">JPG, PNG, or WebP · up to 10 MB</span></label><input class="visually-hidden" id="photo" aria-describedby="photo-error" name="photo" type="file" accept="image/jpeg,image/png,image/webp" /><small class="field-error" id="photo-error" role="status"></small></div>
                <section class="preview-in-form" id="plant-preview" aria-labelledby="preview-in-form-title" hidden>
                  <div class="preview-in-form-heading">
                    <h4 id="preview-in-form-title">Preview a plant in your space</h4>
                    <span>Optional preview</span>
                  </div>
                  <div class="preview-modes" id="preview-modes" role="radiogroup" aria-label="Type of preview" hidden>
                    <label class="preview-mode"><input type="radio" name="previewMode" value="single" checked /><strong>Place one plant</strong><small>See one plant in your space.</small></label>
                    <label class="preview-mode"><input type="radio" name="previewMode" value="makeover" /><strong>Total plant makeover</strong><small>Pick several plants. We rearrange the seating and tables around them.</small></label>
                  </div>
                  <p id="preview-intro">Choose one plant, a style, and a spot. Add a room photo above to see an approximate AI preview. You can continue without creating one.</p>
                  <p class="preview-privacy" id="preview-privacy">Your photo is processed by our AI provider (Kie) to create the preview.</p>
                  <div id="single-picker">
                  <fieldset class="preview-plant-field" aria-describedby="preview-plant-error">
                    <legend>Choose a plant <span class="optional-label">Optional</span></legend>
                    <div class="preview-plant-grid">
                      {catalog.plants.map((plant) => (
                        <div class="preview-plant-option">
                          <label class="preview-plant-card">
                            <input type="radio" name="productId" value={plant.id} />
                            <img src={plant.image} alt="" width="1024" height="1280" loading="lazy" />
                            <span class="preview-plant-name">{plant.name}</span>
                            <span class="preview-plant-size">About {plant.heightCm} cm tall · {plant.potDiameterCm} cm pot</span>
                          </label>
                          <button type="button" class="preview-expand preview-plant-expand" data-plant-image={plant.id} aria-label={`View ${plant.name} photo full screen`}>View full screen</button>
                        </div>
                      ))}
                    </div>
                  </fieldset>
                  <small class="field-error" id="preview-plant-error" role="status"></small>
                  </div>
                  <div id="makeover-picker" hidden>
                    <fieldset class="preview-plant-field" aria-describedby="makeover-error">
                      <legend>Choose your plants and how many <span class="optional-label" id="makeover-total" role="status">0 of 8 plants</span></legend>
                      <div class="preview-plant-grid">
                        {catalog.plants.map((plant) => (
                          <div class="preview-plant-option">
                            <div class="makeover-card">
                              <img src={plant.image} alt="" width="1024" height="1280" loading="lazy" />
                              <span class="preview-plant-name">{plant.name}</span>
                              <span class="preview-plant-size">About {plant.heightCm} cm tall · {plant.potDiameterCm} cm pot</span>
                              <div class="qty" role="group" aria-label={`${plant.name} quantity`}>
                                <button type="button" class="qty-step" data-qty-plant={plant.id} data-qty-step="-1" aria-label={`Fewer ${plant.name}`}>−</button>
                                <input type="number" class="qty-input" data-qty-input={plant.id} min="0" max="8" step="1" value="0" inputmode="numeric" aria-label={`${plant.name} quantity`} />
                                <button type="button" class="qty-step" data-qty-plant={plant.id} data-qty-step="1" aria-label={`More ${plant.name}`}>+</button>
                              </div>
                            </div>
                            <button type="button" class="preview-expand preview-plant-expand" data-plant-image={plant.id} aria-label={`View ${plant.name} photo full screen`}>View full screen</button>
                          </div>
                        ))}
                      </div>
                    </fieldset>
                    <small class="field-error" id="makeover-error" role="status"></small>
                  </div>
                  <div class="field-pair preview-options">
                    <div class="field"><label for="preview-style">Style</label><div class="select-shell"><select id="preview-style" name="style"><option value="">Choose a style</option>{catalog.styles.map((style) => <option value={style.id}>{style.label}</option>)}</select></div></div>
                    <div class="field" id="preview-placement-field"><label for="preview-placement">Placement</label><div class="select-shell"><select id="preview-placement" name="placement" disabled><option value="">Choose a plant first</option></select></div></div>
                  </div>
                  <small class="field-error" id="preview-choice-error" role="status"></small>
                  <button class="button button-green preview-generate" id="preview-generate" type="button"><span id="preview-generate-label">Create my preview</span> <ArrowIcon direction="up-right" /></button>
                  <p class="preview-feedback" id="preview-status" role="status" aria-live="polite" hidden></p>
                  <p class="field-error preview-error" id="preview-error" role="alert" tabindex="-1" hidden></p>
                  <div class="preview-result" id="preview-result" hidden>
                    <p class="preview-result-title" id="preview-result-title"></p>
                    <p class="preview-ai-label" id="preview-ai-label">Approximate AI preview. Plant size and placement may differ in real life.</p>
                    <div class="preview-images"><figure><img id="preview-before" alt="Your room before adding a plant" /><figcaption><span>Before</span><button type="button" class="preview-expand" data-preview-image="before" aria-label="View before photo full screen">View full screen</button></figcaption></figure><figure><img id="preview-after" alt="AI preview of your room with the selected plant" /><figcaption><span>After</span><button type="button" class="preview-expand" data-preview-image="after" aria-label="View after photo full screen">View full screen</button></figcaption></figure></div>
                    <div class="preview-design" id="preview-design" hidden>
                      <h5 class="preview-design-title">How we designed it</h5>
                      <p id="preview-rationale"></p>
                      <ul class="preview-design-list" id="preview-moves" aria-label="Furniture changes"></ul>
                      <ul class="preview-design-list" id="preview-spots" aria-label="Where each plant goes"></ul>
                    </div>
                    <div class="preview-result-actions"><button type="button" class="wizard-back" id="preview-again">Try another look</button><a id="preview-share" href="/#enquiry">Share this preview</a></div>
                    <p class="preview-link-note">Anyone with this result link can view your room photo and preview.</p>
                  </div>
                </section>
                <div class="field"><label for="notes">Anything else we should know? <span class="optional-label">Optional</span></label><textarea id="notes" name="notes" rows="4" placeholder="Tell us about your space, ideas, or questions..."></textarea></div>
                <div class="wizard-actions"><button class="wizard-back" type="button" data-back><ArrowIcon direction="left" /> Back</button><button class="button button-green" type="button" data-next>Continue to contact <span aria-hidden="true"><ArrowIcon direction="right" /></span></button></div>
              </div>

              <div class="form-step" data-step="2" aria-labelledby="step-contact-title" hidden>
                <h3 id="step-contact-title" tabindex="-1">How can we reach you?</h3>
                <p class="step-intro">Just your name and a way to contact you. No account needed.</p>
                <div class="field"><label for="name">Your name <span class="required-label">(required)</span></label><input id="name" aria-describedby="name-error" name="name" type="text" autocomplete="name" placeholder="Your full name" required /><small class="field-error" id="name-error" role="status"></small></div>
                <fieldset class="field"><legend>How should we contact you? <span class="required-label">(required)</span></legend><div class="choice-row"><label><input type="radio" name="contactMethod" value="Email" checked /> Email</label><label><input type="radio" name="contactMethod" value="Phone" /> Phone</label></div></fieldset>
                <div class="field"><label for="contact" id="contact-label">Email address <span class="required-label">(required)</span></label><input id="contact" aria-describedby="contact-error" name="contact" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required /><small class="field-error" id="contact-error" role="status"></small></div>
                <div class="wizard-actions"><button class="wizard-back" type="button" data-back><ArrowIcon direction="left" /> Back</button><button class="button button-green" id="enquiry-submit" type="submit">Send your request <span aria-hidden="true"><ArrowIcon direction="up-right" /></span></button></div>
                <p class="preview-feedback" id="submit-status" role="status" hidden></p>
                <p class="field-error submit-error" id="submit-error" role="alert" tabindex="-1" hidden></p>
                <p class="form-disclaimer">We'll use these details to follow up about your plant plan.</p>
              </div>
            </form>
            <dialog class="preview-lightbox" id="preview-lightbox" aria-label="Full screen preview photo">
              <div class="preview-lightbox-inner">
                <div class="preview-lightbox-bar"><span id="preview-lightbox-title"></span><button type="button" id="preview-lightbox-close" aria-label="Close full screen photo">Close <span aria-hidden="true">×</span></button></div>
                <img id="preview-lightbox-image" alt="" />
              </div>
            </dialog>
            <div class="form-success" id="form-success" hidden tabindex="-1"><span class="success-mark" aria-hidden="true">✓</span><h3>Request sent.</h3><p>Thanks. We'll use your details to follow up about your plant plan.</p><div id="request-summary"></div><button type="button" id="start-again" class="button button-dark">Start a new request <span aria-hidden="true"><ArrowIcon direction="up-right" /></span></button></div>
          </div>
        </div>
      </section>

      <section class="section process-section" id="how-it-works" aria-labelledby="process-title">
        <div class="container">
          <div class="process-top">
            <div>
              <p class="eyebrow light">How it works <span class="eyebrow-line"></span></p>
              <h2 id="process-title">From first hello<br />to <em>right at home.</em></h2>
            </div>
            <p>Three simple steps to greenery that works for your space, your people, and your everyday routine.</p>
          </div>
          <div class="steps">
            <article class="step"><span class="step-number">01</span><div class="step-rule"></div><h3>Share your space</h3><p>Tell us what kind of space you have and how to reach you. Light, size, and a photo help, but they’re optional.</p></article>
            <article class="step"><span class="step-number">02</span><div class="step-rule"></div><h3>Explore your options</h3><p>We recommend a curated plant package suited to your conditions, style, and budget. You choose what feels right.</p></article>
            <article class="step"><span class="step-number">03</span><div class="step-rule"></div><h3>Find their place</h3><p>We plan placement around your layout and flow, with support to help your new plants settle in.</p></article>
          </div>
          <a class="button button-cream" href="/#enquiry">Let’s plan your space <span aria-hidden="true"><ArrowIcon direction="up-right" /></span></a>
        </div>
      </section>

      <section class="section faq-section" id="faq" aria-labelledby="faq-title">
        <div class="container faq-grid">
          <div class="faq-heading">
            <p class="eyebrow green">Good to know <span class="eyebrow-line"></span></p>
            <h2 id="faq-title">A few things<br />you might <em>wonder.</em></h2>
            <p>Still have a question? Send it along with your plant plan request.</p>
          </div>
          <div class="faq-list">
            {questions.map((item) => (
              <details>
                <summary>{item.question}<span class="faq-plus" aria-hidden="true">+</span></summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

    <script>
      import { initPlantPlan } from '../scripts/plantPlan';
      const PREVIEW_ENABLED = true;
      const MAKEOVER_ENABLED = true; // Preview trial; Production requires G0/G1 and approved product photos
      initPlantPlan(PREVIEW_ENABLED, MAKEOVER_ENABLED);

      // Native centered snapping owns touch momentum; controls and mouse drag share its targets.
      const solutions = document.querySelector<HTMLElement>('.solutions-section');
      const track = document.querySelector<HTMLElement>('#space-track');
      if (solutions && track) {
        const originals = [...track.children] as HTMLElement[];
        const count = originals.length;
        const cloneSet = () => originals.map((card) => card.cloneNode(true) as HTMLElement);
        // A complete copy on either side keeps neighboring previews intact at the seam.
        track.prepend(...cloneSet());
        track.append(...cloneSet());
        const cards = [...track.children] as HTMLElement[];
        const surfaces = cards.map((card) => card.querySelector<HTMLElement>('.space-card-surface')!);
        const photos = cards.map((card) => card.querySelector<HTMLImageElement>('.space-image img')!);
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
        const cssDepth = CSS.supports('animation-timeline: view()');
        const logicalIndex = (index: number) => ((index % count) + count) % count;
        const chips = [...solutions.querySelectorAll<HTMLButtonElement>('.slider-chip')];
        const [prev, next] = solutions.querySelectorAll<HTMLButtonElement>('.slider-arrow');
        const status = solutions.querySelector<HTMLElement>('.slider-status');
        let active = count;
        let requested = count;
        let pointerDown = false;
        let navigating = false;
        const targetLeft = (index: number) => cards[index].offsetLeft - (track.clientWidth - cards[index].offsetWidth) / 2;
        const update = () => {
          // Read layout once before writing styles. Motion follows the swipe, including reversals.
          const positions = cards.map((_, i) => targetLeft(i) - track.scrollLeft);
          const spacing = cards[1].offsetLeft - cards[0].offsetLeft;
          const distances = positions.map(Math.abs);
          active = distances.indexOf(Math.min(...distances));
          cards.forEach((card, i) => {
            if (!cssDepth) {
              // ponytail: fallback for browsers without scroll-driven animations (Firefox); lags the scroll by a frame
              const position = Math.max(-1, Math.min(1, positions[i] / spacing));
              const distance = Math.abs(position);
              surfaces[i].style.transform = reduceMotion.matches ? 'none' : `translate3d(0, ${distance * 6}px, 0) scale(${1 - distance * .04})`;
              surfaces[i].style.opacity = String(1 - distance * .25);
              photos[i].style.transform = reduceMotion.matches ? 'none' : `translate3d(${position * -12}px, 0, 0) scale(1.08)`;
            }
            card.toggleAttribute('data-active', i === active);
            card.setAttribute('aria-hidden', String(i !== active));
            card.querySelector<HTMLAnchorElement>('a')!.tabIndex = i === active ? 0 : -1;
          });
          chips.forEach((chip, i) => chip.setAttribute('aria-current', String(i === logicalIndex(active))));
        };
        const announce = () => {
          if (pointerDown) return;
          update();
          // Move to the identical middle copy only after scrolling settles, without animation.
          const centered = count + logicalIndex(active);
          if (centered !== active) {
            track.classList.add('is-rebasing');
            track.scrollTo({ left: targetLeft(centered), behavior: 'instant' });
            active = centered;
            update();
            requestAnimationFrame(() => track.classList.remove('is-rebasing'));
          }
          navigating = false;
          requested = active;
          if (status) status.textContent = `${String(logicalIndex(active) + 1).padStart(2, '0')} / ${String(count).padStart(2, '0')} - ${cards[active].querySelector('h3')!.textContent}`;
        };
        const goTo = (index: number, instant = false) => {
          if (index < 0 || index >= cards.length) {
            // Rapid repeated arrow presses can outrun the settle event.
            const shift = index < 0 ? count : -count;
            track.scrollTo({ left: track.scrollLeft + targetLeft(count + shift) - targetLeft(count), behavior: 'instant' });
            index += shift;
          }
          requested = index;
          navigating = true;
          track.scrollTo({ left: targetLeft(requested), behavior: instant ? 'instant' : 'auto' });
          if (instant) { update(); announce(); }
        };
        chips.forEach((chip, i) => chip.addEventListener('click', () => {
          const nearest = [i, count + i, count * 2 + i].sort((a, b) => Math.abs(a - active) - Math.abs(b - active))[0];
          goTo(nearest);
        }));
        prev.addEventListener('click', () => goTo((navigating ? requested : active) - 1));
        next.addEventListener('click', () => goTo((navigating ? requested : active) + 1));
        track.addEventListener('keydown', (event) => {
          if (event.target !== track) return;
          // Keyboard navigation responds immediately; pointer controls retain their glide.
          const from = navigating ? requested : active;
          const index = { ArrowLeft: from - 1, ArrowRight: from + 1, Home: count, End: count * 2 - 1 }[event.key];
          if (index === undefined) return;
          event.preventDefault();
          goTo(index, true);
        });

        let drag: { x: number; left: number; index: number } | undefined;
        let dragged = false;
        track.addEventListener('pointerdown', (event) => {
          pointerDown = true;
          navigating = false;
          if (event.pointerType !== 'mouse' || event.button !== 0) return;
          dragged = false;
          drag = { x: event.clientX, left: track.scrollLeft, index: active };
        });
        addEventListener('pointermove', (event) => {
          if (!drag) return;
          const dx = event.clientX - drag.x;
          if (!dragged && Math.abs(dx) < 6) return;
          if (!dragged) { dragged = true; track.classList.add('is-dragging'); getSelection()?.removeAllRanges(); }
          track.scrollTo({ left: drag.left - dx, behavior: 'instant' });
        });
        const finishDrag = () => {
          pointerDown = false;
          if (!drag) { clearTimeout(scrollTimer); scrollTimer = setTimeout(announce, 180); return; }
          const start = drag;
          drag = undefined;
          track.classList.remove('is-dragging');
          if (!dragged) return;
          const distance = track.scrollLeft - start.left;
          goTo(Math.abs(distance) > 40 ? start.index + Math.sign(distance) : start.index);
          setTimeout(() => { dragged = false; }, 0);
        };
        addEventListener('pointerup', finishDrag);
        addEventListener('pointercancel', finishDrag);
        addEventListener('blur', finishDrag);
        track.addEventListener('click', (event) => {
          if (dragged) { event.preventDefault(); event.stopPropagation(); return; }
          const card = (event.target as Element).closest<HTMLElement>('.space-card');
          if (card && cards.indexOf(card) !== active) {
            event.preventDefault();
            event.stopPropagation();
            goTo(cards.indexOf(card));
          }
        }, true);
        track.addEventListener('dragstart', (event) => event.preventDefault());
        let scrollTimer: ReturnType<typeof setTimeout>;
        track.addEventListener('scroll', () => {
          update();
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(announce, 160);
        }, { passive: true });
        track.addEventListener('scrollend', announce);
        reduceMotion.addEventListener('change', update);
        solutions.setAttribute('data-ready', '');
        goTo(count, true);
        new ResizeObserver(() => goTo(count + logicalIndex(active), true)).observe(track);
      }

      // Scroll reveal, once per element. Only content below the fold at load is hidden,
      // so nothing the reader can already see disappears, and no-JS/reduced-motion just shows everything.
      const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
      if (!motionPreference.matches && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.filter((entry) => entry.isIntersecting).forEach((entry, i) => {
            const el = entry.target as HTMLElement;
            el.style.setProperty('--delay', `${Math.min(i, 5) * 60}ms`); // stagger what arrives together, capped at 300ms
            el.removeAttribute('data-pending');
            el.setAttribute('data-in', '');
            revealObserver.unobserve(el);
          });
        }, { rootMargin: '0px 0px -10% 0px' });
        const revealTargets = [...document.querySelectorAll<HTMLElement>('.principles-inner > div, .image-badge, .concept-copy > *, .solutions-heading > *, .slider-controls, .space-grid, .categories-heading > *, .category-grid > li, .process-top > *, .step, .faq-heading > *, .faq-list details, .enquiry-copy > *, .form-panel')]
          .filter((el) => el.getBoundingClientRect().top > innerHeight); // all reads before any writes
        motionPreference.addEventListener('change', () => {
          if (!motionPreference.matches) return;
          revealObserver.disconnect();
          revealTargets.forEach((el) => el.removeAttribute('data-pending'));
        });
        revealTargets.forEach((el) => {
          // Headings rise line by line: wrap each <br>-separated line in a span the CSS staggers by --i.
          // The space between spans keeps words apart where the lines flow inline (concept heading on mobile).
          const heading = el.matches('h2') ? el : el.querySelector('h2');
          if (heading) heading.innerHTML = heading.innerHTML.split(/<br\b[^>]*>/i).map((line, i) => `<span class="heading-line" style="--i: ${i}">${line}</span>`).join(' ');
          el.setAttribute('data-pending', '');
          revealObserver.observe(el);
        });
      }

    </script>
</BaseLayout>
