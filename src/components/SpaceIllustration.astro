  </>}
  {variant === 'school' && <>
    <rect x="78" y="20" width="112" height="63" rx="5" fill="#fafbf6" stroke="#aebda6" stroke-width="2" />
    <path d="M134 21v60M80 51h108" stroke="#b8c6b0" stroke-width="2" />
    <path d="M47 87h226" stroke="#91a58b" stroke-width="2" stroke-linecap="round" />
    <path d="M94 67h27v18H94z" fill="#d8b17a" /><path d="M98 62h27v18H98z" fill="#9eb48f" />
    <path d="M210 87h37l-4 15h-29z" fill="#bb8766" />
    <path class="illustration-sway" d="M229 87c0-13-10-18-8-28 8 5 12 11 11 21 2-12 10-19 18-21 0 12-7 22-18 28m-2-7c-7-11-5-18 0-25 6 9 7 17 2 27" fill="#6f916b" />
  </>}
  {variant === 'retail' && <>
    <path d="M65 45h190v42H65z" fill="#fafbf6" stroke="#aebda6" stroke-width="2" />
    <path d="M58 45h204l-11-22H69z" fill="#91a982" stroke="#72886c" stroke-width="2" stroke-linejoin="round" />
    <path d="M92 24l12 21m28-21 1 21m30-21-4 21m33-21-8 21m34-21-12 21" stroke="#eaf0e5" stroke-width="9" />
    <rect x="87" y="58" width="48" height="29" rx="2" fill="#e6eee1" stroke="#b8c6b0" stroke-width="2" />
    <path d="M188 87h37l-4 15h-29z" fill="#bb8766" />
    <path class="illustration-sway" d="M207 87c-1-12-10-16-9-25 9 3 12 10 12 19 2-12 10-20 18-21 0 12-7 21-18 27m-2-5c-7-11-5-18 0-25 6 10 7 18 2 27" fill="#6f916b" />
  </>}
  {variant === 'other' && <>
    <path d="M50 84h220" stroke="#91a58b" stroke-width="2" stroke-linecap="round" />
    <path d="M160 23c6 20 13 27 34 33-21 6-28 13-34 34-6-21-13-28-34-34 21-6 28-13 34-33z" fill="#9fb392" />
    <circle cx="97" cy="43" r="10" fill="#d4b382" /><circle cx="226" cy="68" r="8" fill="#bb8766" />
  </>}
</svg>
<style>
  .space-illustration { display: block; grid-column: 1 / -1; width: calc(100% + 28px); max-width: none; height: 90px; margin: 0 -14px 13px; }
</style>
