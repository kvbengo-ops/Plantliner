---
interface Props {
  variant: 'office' | 'cafe' | 'school' | 'retail' | 'other';
}
const { variant } = Astro.props;
---
<svg class={`space-illustration illustration-${variant}`} viewBox="0 0 320 110" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect width="320" height="110" rx="12" fill="#eaf0e5" />
  <circle cx="270" cy="20" r="31" fill="#f4f1df" />
  {variant === 'office' && <>
    <path d="M28 80h264" stroke="#91a58b" stroke-width="2" stroke-linecap="round" />
    <rect x="72" y="24" width="116" height="56" rx="5" fill="#fafbf6" stroke="#aebda6" stroke-width="2" />
    <path d="M130 25v54M74 52h112" stroke="#b8c6b0" stroke-width="2" />
    <path d="M94 81h73" stroke="#72886c" stroke-width="3" stroke-linecap="round" />
    <path d="M105 92h52l-6-11h-40z" fill="#a5b89a" />
    <path d="M218 87h37l-4 15h-29z" fill="#bb8766" />
    <path class="illustration-sway" d="M237 87c-1-12-11-15-11-26 10 4 14 10 13 18 2-13 9-22 19-24-1 13-6 22-17 29m-2-5c-8-13-7-21-2-28 7 10 8 18 4 29" fill="#6f916b" />
  </>}
  {variant === 'cafe' && <>
    <path d="M49 79h222" stroke="#91a58b" stroke-width="2" stroke-linecap="round" />
    <path d="M89 51h92l-8 34h-76z" fill="#fafbf6" stroke="#aebda6" stroke-width="2" stroke-linejoin="round" />
    <path d="M181 59h11a11 11 0 0 1 0 22h-16" fill="none" stroke="#aebda6" stroke-width="3" />
    <path d="M107 43c-6-8 6-10 0-18m24 18c-6-8 6-10 0-18m24 18c-6-8 6-10 0-18" fill="none" stroke="#9cad94" stroke-width="2" stroke-linecap="round" />
    <path d="M205 86h38l-4 15h-29z" fill="#bb8766" />
